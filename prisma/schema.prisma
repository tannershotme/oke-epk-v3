generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  eventType    String?
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contact_submissions")
}
